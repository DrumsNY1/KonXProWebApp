@inherits LayoutComponentBase
<RadzenComponents />

<div class="@(isSidebarOpen ? "sidebar-open" : "sidebar-collapsed")">
  <div class="sidebar">
    <div class="sidebar-logo">
      <div class="logo-icon">K</div>
      <span class="logo-text">Kon<span>X</span>Pro</span>
      <button class="sidebar-close-btn" @onclick="ToggleSidebar" aria-label="Close menu"><RadzenIcon Icon="close" /></button>
    </div>

  <nav class="sidebar-nav">
    <div class="nav-section-label">Main</div>
    <a class="nav-item" href="permit-intel/search" Match="NavLinkMatch.Prefix">
      <RadzenIcon Icon="feed" class="nav-icon" /> Permit Feed
    </a>
    <a class="nav-item" href="permit-intel/leads">
      <RadzenIcon Icon="bookmark" class="nav-icon" /> Saved Leads
    </a>
    <a class="nav-item" href="permit-intel/alerts">
      <RadzenIcon Icon="notifications" class="nav-icon" /> Alerts
    </a>

    <div class="nav-section-label">Tools</div>
    <a class="nav-item" href="permit-intel/map">
      <RadzenIcon Icon="map" class="nav-icon" /> Map
    </a>
    <a class="nav-item" href="permit-intel/dashboard">
      <RadzenIcon Icon="analytics" class="nav-icon" /> Reports
    </a>

    <AuthorizeView Roles="Admin, Marketing">
      <Authorized>
        <div class="nav-section-label">Admin</div>
        <a class="nav-item" href="admin/contractors">
          <RadzenIcon Icon="engineering" class="nav-icon" /> Contractors
        </a>
      </Authorized>
    </AuthorizeView>

    <div class="nav-section-label">Account</div>
    <a class="nav-item" href="profile">
      <RadzenIcon Icon="settings" class="nav-icon" /> Profile & Settings
    </a>
    <a class="nav-item text-accent" href="permit-intel/subscribe">
      <RadzenIcon Icon="bolt" class="nav-icon" /> Upgrade to Pro
    </a>
  </nav>

  <div class="sidebar-upgrade">
    <div class="upgrade-label"><RadzenIcon Icon="bolt" Style="font-size: 14px; vertical-align: middle; margin-right: 2px;" /> Pro Trial</div>
    <p>7 days left — upgrade to keep unlimited leads and SMS alerts.</p>
    <button class="btn-upgrade" @onclick='() => NavigationManager.NavigateTo("permit-intel/subscribe")'>Upgrade Now — $149/mo</button>
  </div>

  <div class="sidebar-user" @onclick='() => NavigationManager.NavigateTo("profile")'>
    <div class="user-avatar">
        @(string.IsNullOrEmpty(Security.User?.Name) || Security.User?.Name == "Anonymous" ? "US" : Security.User.Name.Substring(0, Math.Min(2, Security.User.Name.Length)).ToUpper())
    </div>
    <div>
      <div class="user-name">@(Security.User?.Name ?? "User")</div>
      <div class="user-plan">Active Member</div>
    </div>
  </div>
  </div>

  @* Backdrop overlay for mobile — tap outside sidebar to close *@
  @if (isSidebarOpen)
  {
    <div class="sidebar-backdrop" @onclick="CloseSidebar"></div>
  }

  <div class="main">
    <!-- TOP BAR -->
    <header class="topbar">
      <button class="hamburger-btn" @onclick="ToggleSidebar" aria-label="Toggle Navigation Menu"><RadzenIcon Icon="menu" /></button>
      <div class="topbar-search">
        <RadzenIcon Icon="search" class="text-muted-color" Style="font-size: 18px;" />
        <input type="text" placeholder="Search permits, addresses, owners..." @onkeydown="SearchGlobal" />
      </div>
    <div class="topbar-date">@DateTime.Today.ToString("ddd, MMMM d, yyyy")</div>
    <div class="topbar-actions">
      <button class="topbar-btn" @onclick='() => NavigationManager.NavigateTo("permit-intel/map")' aria-label="Map">
        <RadzenIcon Icon="map" />
      </button>
      <button class="topbar-btn" @onclick='() => NavigationManager.NavigateTo("permit-intel/alerts")' aria-label="Alerts">
        <RadzenIcon Icon="notifications" />
      </button>
      <div class="topbar-avatar" @onclick='() => NavigationManager.NavigateTo("profile")'>
        @(string.IsNullOrEmpty(Security.User?.Name) || Security.User?.Name == "Anonymous" ? "US" : Security.User.Name.Substring(0, Math.Min(2, Security.User.Name.Length)).ToUpper())
      </div>
    </div>
  </header>

  <!-- CONTENT -->
  <div class="content">
    <div class="content-main">
        @Body
    </div>
  </div>
</div>
</div>

@code {
    private void SearchGlobal(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            NavigationManager.NavigateTo("permit-intel/search");
        }
    }
}
