@page "/about-us"
@layout KonXProWebApp.Components.Layout.LandingLayout

<PageTitle>About Us — KonXPro</PageTitle>

<div class="about-page-container" style="max-width: 1040px; margin: 0 auto; padding: 48px 24px 96px 24px;">
    <!-- HERO -->
    <div style="text-align: center; margin-bottom: 56px;">
        <span style="display: inline-block; padding: 6px 14px; background: rgba(37,99,235,0.12); color: var(--color-primary-light, #60a5fa); border-radius: 9999px; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px;">Our Story & Mission</span>
        <h1 style="font-size: clamp(32px, 4vw, 44px); font-weight: 800; color: var(--text-primary, #f8fafc); margin: 0 0 16px 0;">Built for NYC Trade Contractors</h1>
        <p style="font-size: 18px; color: var(--text-muted, #94a3b8); max-width: 720px; margin: 0 auto; line-height: 1.6;">
            We created KonXPro to level the playing field for independent trade contractors across New York City by transforming raw public building permit records into actionable, real-time business opportunities.
        </p>
    </div>

    <!-- MISSION / STORY -->
    <div style="background: var(--surface-card, #0a1628); border: 1px solid var(--border-default, #1e293b); border-radius: 16px; padding: 40px; margin-bottom: 48px;">
        <h2 style="font-size: 24px; font-weight: 700; color: var(--text-primary, #f8fafc); margin: 0 0 16px 0;">Why Timing Is Everything in NYC</h2>
        <p style="font-size: 15px; color: var(--text-secondary, #cbd5e1); line-height: 1.8; margin-bottom: 16px;">
            In New York City, thousands of construction, alteration, and trade permits are filed every single month with the Department of Buildings (DOB). By the time a project hits public job boards or contractor bidding directories, general contractors and property owners have already chosen their primary subcontractors.
        </p>
        <p style="font-size: 15px; color: var(--text-secondary, #cbd5e1); line-height: 1.8; margin: 0;">
            KonXPro monitors and indexes NYC DOB public filings around the clock. The instant a homeowner or developer files an application in your trade and territory, you receive a direct notification with verified property and filing details — empowering you to make contact first and win the contract.
        </p>
    </div>

    <!-- 3 CORE PILLARS -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-bottom: 56px;">
        <div class="card" style="padding: 32px; background: var(--surface-card, #0a1628); border: 1px solid var(--border-default, #1e293b); border-radius: 12px;">
            <div style="width: 48px; height: 48px; border-radius: 10px; background: rgba(37,99,235,0.15); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                <RadzenIcon Icon="bolt" Style="color: var(--color-primary-light, #60a5fa); font-size: 26px;" />
            </div>
            <h3 style="font-size: 19px; font-weight: 700; color: var(--text-primary, #f8fafc); margin: 0 0 10px 0;">Speed Over Scraping</h3>
            <p style="font-size: 14px; color: var(--text-muted, #94a3b8); line-height: 1.6; margin: 0;">
                Direct daily synchronization with NYC DOB datasets means you receive permit alerts within hours of filing, not weeks after work has commenced.
            </p>
        </div>

        <div class="card" style="padding: 32px; background: var(--surface-card, #0a1628); border: 1px solid var(--border-default, #1e293b); border-radius: 12px;">
            <div style="width: 48px; height: 48px; border-radius: 10px; background: rgba(16,185,129,0.15); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                <RadzenIcon Icon="my_location" Style="color: #34d399; font-size: 26px;" />
            </div>
            <h3 style="font-size: 19px; font-weight: 700; color: var(--text-primary, #f8fafc); margin: 0 0 10px 0;">Laser Territory Targeting</h3>
            <p style="font-size: 14px; color: var(--text-muted, #94a3b8); line-height: 1.6; margin: 0;">
                Focus only on the boroughs, neighborhoods, and trades you actually service. Never waste time sifting through irrelevant out-of-area filings.
            </p>
        </div>

        <div class="card" style="padding: 32px; background: var(--surface-card, #0a1628); border: 1px solid var(--border-default, #1e293b); border-radius: 12px;">
            <div style="width: 48px; height: 48px; border-radius: 10px; background: rgba(245,158,11,0.15); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                <RadzenIcon Icon="money_off" Style="color: #fbbf24; font-size: 26px;" />
            </div>
            <h3 style="font-size: 19px; font-weight: 700; color: var(--text-primary, #f8fafc); margin: 0 0 10px 0;">No Per-Lead Extortion</h3>
            <p style="font-size: 14px; color: var(--text-muted, #94a3b8); line-height: 1.6; margin: 0;">
                Unlike lead broker marketplaces that charge you $150+ for a lead shared with 8 competitors, KonXPro operates on transparent, flat monthly subscriptions.
            </p>
        </div>
    </div>

    <!-- CALL TO ACTION -->
    <div style="text-align: center; background: linear-gradient(135deg, rgba(37,99,235,0.15), rgba(30,58,138,0.25)); border: 1px solid var(--border-default, #1e293b); border-radius: 16px; padding: 48px 24px;">
        <h2 style="font-size: 28px; font-weight: 800; color: var(--text-primary, #f8fafc); margin: 0 0 12px 0;">Ready to Dominate Your NYC Territory?</h2>
        <p style="font-size: 16px; color: var(--text-muted, #94a3b8); margin: 0 auto 24px auto; max-width: 500px;">
            Start your 14-day free trial today and experience real-time permit intelligence.
        </p>
        <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
            <button type="button" class="btn-primary" @onclick='() => NavigationManager.NavigateTo("Login?register=true")' style="padding: 12px 24px; font-size: 15px; font-weight: 600;">
                Start Free Trial
            </button>
            <button type="button" class="btn-ghost" @onclick='() => NavigationManager.NavigateTo("contact-us")' style="padding: 12px 24px; font-size: 15px; font-weight: 600;">
                Contact Sales
            </button>
        </div>
    </div>
</div>
