@page "/permit-intel/search"
@attribute [Authorize]
@using KonXProWebApp.Models.db_9f8bee_konxdev
@using KonXProWebApp.Models.PermitIntel

<PageTitle>Permit Search — NYC Permit Intel</PageTitle>

<!-- PAGE HEADER WITH CONSOLIDATED COMPACT STATS -->
<div class="page-header-with-stats">
    <div class="header-left">
        <h1>Permit Feed</h1>
        <p>Live DOB Feed · @($"{totalCount:N0}") permits matching your criteria</p>
    </div>
    <div class="header-stats-strip" role="region" aria-label="Permit feed summary metrics">
        <div class="header-stat-item" title="New Leads matching your criteria">
            <RadzenIcon Icon="bolt" class="header-stat-icon text-amber" />
            <div class="header-stat-meta">
                <span class="header-stat-label">New Leads</span>
                <span class="header-stat-val">@($"{totalCount:N0}")</span>
            </div>
        </div>
        <div class="header-stat-divider"></div>
        <div class="header-stat-item" title="Active Permits in database">
            <RadzenIcon Icon="assignment" class="header-stat-icon text-info" />
            <div class="header-stat-meta">
                <span class="header-stat-label">Active Permits</span>
                <span class="header-stat-val">@($"{activePermitsCount:N0}")</span>
            </div>
        </div>
        <div class="header-stat-divider"></div>
        <div class="header-stat-item" title="Estimated Job Value across all permits">
            <RadzenIcon Icon="attach_money" class="header-stat-icon text-success" />
            <div class="header-stat-meta">
                <span class="header-stat-label">Job Value</span>
                <span class="header-stat-val">@FormatCurrency(totalJobValue)</span>
            </div>
        </div>
        <div class="header-stat-divider"></div>
        <div class="header-stat-item" title="Leads being tracked in your pipeline">
            <RadzenIcon Icon="bookmark" class="header-stat-icon text-primary" />
            <div class="header-stat-meta">
                <span class="header-stat-label">Pipeline</span>
                <span class="header-stat-val">@($"{savedLeadCount:N0}")</span>
            </div>
        </div>
    </div>
</div>

<div class="card rz-mb-4">
    <div class="card-header">
        <div>
            <div class="card-title">Live Permit Feed</div>
            <div class="card-subtitle">Filter by Borough, Type, Trade, and Date</div>
        </div>
        <div class="card-actions">
            <RadzenButton Text="Search" Icon="search" ButtonStyle="Radzen.ButtonStyle.Primary" Size="Radzen.ButtonSize.Small" Click="@SearchPermits" />
            <RadzenButton Text="Export CSV" Icon="get_app" ButtonStyle="Radzen.ButtonStyle.Light" Size="Radzen.ButtonSize.Small" Click="@(() => ExportClick("csv"))" />
        </div>
    </div>
    <div class="rz-p-4">
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenLabel Text="Boroughs" class="rz-mb-1 rz-display-block" />
                <RadzenDropDown @bind-Value="selectedBoroughs" Data="@boroughOptions"
                                TextProperty="Name" ValueProperty="Name"
                                Multiple="true" AllowClear="true"
                                Placeholder="All Boroughs"
                                Chips="true" MaxSelectedLabels="2"
                                Change="@(args => SearchPermits())"
                                Style="width: 100%;" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenLabel Text="Job Types" class="rz-mb-1 rz-display-block" />
                <RadzenDropDown @bind-Value="selectedJobTypes" Data="@jobTypeOptions"
                                TextProperty="Name" ValueProperty="Key"
                                Multiple="true" AllowClear="true"
                                Placeholder="All Job Types"
                                Chips="true" MaxSelectedLabels="2"
                                Change="@(args => SearchPermits())"
                                Style="width: 100%;" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenLabel Text="Trades" class="rz-mb-1 rz-display-block" />
                <RadzenDropDown @bind-Value="selectedTrades" Data="@tradeOptions"
                                TextProperty="Name" ValueProperty="Key"
                                Multiple="true" AllowClear="true"
                                Placeholder="All Trades"
                                Chips="true" MaxSelectedLabels="2"
                                Change="@(args => SearchPermits())"
                                Style="width: 100%;" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow class="rz-mt-4" Gap="1rem">
            <RadzenColumn Size="12" SizeMD="3">
                <label for="dateFromInput" class="rz-mb-1 rz-display-block rz-label">Date From</label>
                <input id="dateFromInput" type="date" class="native-date-picker" @bind-value="dateFrom" aria-label="Filter from date" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <label for="dateToInput" class="rz-mb-1 rz-display-block rz-label">Date To</label>
                <input id="dateToInput" type="date" class="native-date-picker" @bind-value="dateTo" aria-label="Filter to date" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <label for="minCostInput" class="rz-mb-1 rz-display-block rz-label">Min Cost ($)</label>
                <RadzenNumeric @bind-Value="minCost" Style="width: 100%;" Name="numMin" Placeholder="0" Format="N0" aria-label="Minimum cost in dollars" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <label for="maxCostInput" class="rz-mb-1 rz-display-block rz-label">Max Cost ($)</label>
                <RadzenNumeric @bind-Value="maxCost" Style="width: 100%;" Name="numMax" Placeholder="No limit" Format="N0" aria-label="Maximum cost in dollars" />
            </RadzenColumn>
        </RadzenRow>
    </div>

    @* ── Filter Summary Bar (visible only when filters are active) ── *@
    @if (ActiveFilterCount > 0)
    {
        <div class="filter-summary-bar">
            <div class="filter-summary-info">
                <span class="filter-summary-badge">@ActiveFilterCount filter@(ActiveFilterCount != 1 ? "s" : "") active</span>
                <span class="filter-summary-sep">·</span>
                <span class="filter-summary-results">@($"{totalCount:N0}") results</span>
            </div>
            <div class="filter-summary-pills">
                @foreach (var b in GetEffectiveBoroughs())
                {
                    var captured = b;
                    <button class="filter-pill" @onclick="() => RemoveBoroughFilter(captured)" aria-label="@($"Remove {b} filter")">@b ×</button>
                }
                @foreach (var j in GetEffectiveJobTypes())
                {
                    var captured = j;
                    var label = jobTypeOptions.FirstOrDefault(x => x.Key == j)?.Name ?? j;
                    <button class="filter-pill" @onclick="() => RemoveJobTypeFilter(captured)" aria-label="@($"Remove {label} filter")">@label ×</button>
                }
                @foreach (var t in GetEffectiveTrades())
                {
                    var captured = t;
                    var label = tradeOptions.FirstOrDefault(x => x.Key == t)?.Name ?? t;
                    <button class="filter-pill" @onclick="() => RemoveTradeFilter(captured)" aria-label="@($"Remove {label} filter")">@label ×</button>
                }
                @if (dateFrom.HasValue)
                {
                    <button class="filter-pill" @onclick="RemoveDateFrom" aria-label="Remove date-from filter">From @dateFrom.Value.ToString("M/d/yy") ×</button>
                }
                @if (dateTo.HasValue)
                {
                    <button class="filter-pill" @onclick="RemoveDateTo" aria-label="Remove date-to filter">To @dateTo.Value.ToString("M/d/yy") ×</button>
                }
                @if (minCost.HasValue)
                {
                    <button class="filter-pill" @onclick="RemoveMinCost" aria-label="Remove minimum cost filter">Min $@minCost.Value.ToString("N0") ×</button>
                }
                @if (maxCost.HasValue)
                {
                    <button class="filter-pill" @onclick="RemoveMaxCost" aria-label="Remove maximum cost filter">Max $@maxCost.Value.ToString("N0") ×</button>
                }
            </div>
            <button class="filter-clear-all" @onclick="ClearAllFilters"><RadzenIcon Icon="close" Style="font-size: 13px; vertical-align: middle; margin-right: 2px;" /> Clear All</button>
        </div>
    }

    @* ── Desktop: Data Grid (hidden below 768px) ── *@
    <div class="desktop-grid">
        <RadzenDataGrid @ref="grid0" Data="@permits" Count="@totalCount" LoadData="@OnLoadData" TItem="DobjobFiling"
                        AllowSorting="true" AllowPaging="true" PageSize="25"
                        PageSizeOptions="@(new int[]{10, 25, 50, 100})"
                        ShowPagingSummary="true" PagerHorizontalAlign="Radzen.HorizontalAlign.Center"
                        AllowColumnResize="true" ColumnWidth="180px"
                        Style="min-height: 400px;" class="rz-border-top">
            <Columns>
                <RadzenDataGridColumn TItem="DobjobFiling" Property="JobNum" Title="Permit #" Width="90px" TextAlign="TextAlign.Center">
                    <HeaderTemplate>
                        <button type="button" class="grid-sort-header-btn"
                                @onclick="() => SortByColumn(nameof(DobjobFiling.JobNum))"
                                aria-label="@GetSortAriaLabel("Permit Number", nameof(DobjobFiling.JobNum))"
                                aria-sort="@GetAriaSort(nameof(DobjobFiling.JobNum))">
                            <span>Permit #</span>
                            <span class="sort-indicator" aria-hidden="true">@GetSortIndicator(nameof(DobjobFiling.JobNum))</span>
                        </button>
                    </HeaderTemplate>
                    <Template Context="filing">
                        @{
                            var permitNumber = filing.JobFilingNumber ?? filing.JobNum?.ToString() ?? "Permit";
                        }
                        <button type="button" class="permit-icon-btn"
                                @onclick="() => ViewDetail(filing)"
                                title="@permitNumber"
                                aria-label="@($"View permit details for {permitNumber}")">
                            <RadzenIcon Icon="description" />
                        </button>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DobjobFiling" Property="StreetName" Title="Address" Width="180px">
                    <HeaderTemplate>
                        <button type="button" class="grid-sort-header-btn"
                                @onclick="() => SortByColumn(nameof(DobjobFiling.StreetName))"
                                aria-label="@GetSortAriaLabel("Address", nameof(DobjobFiling.StreetName))"
                                aria-sort="@GetAriaSort(nameof(DobjobFiling.StreetName))">
                            <span>Address</span>
                            <span class="sort-indicator" aria-hidden="true">@GetSortIndicator(nameof(DobjobFiling.StreetName))</span>
                        </button>
                    </HeaderTemplate>
                    <Template Context="filing">
                        <span class="permit-addr">@filing.HouseNum @filing.StreetName</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DobjobFiling" Property="JobDescription" Title="Description" Width="280px" Sortable="false">
                    <Template Context="filing">
                        <span class="desc-cell" title="@filing.JobDescription">
                            @KonXProWebApp.Services.DescriptionHelper.Summarize(filing)
                        </span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DobjobFiling" Property="Borough" Title="Borough" Width="100px">
                    <HeaderTemplate>
                        <button type="button" class="grid-sort-header-btn"
                                @onclick="() => SortByColumn(nameof(DobjobFiling.Borough))"
                                aria-label="@GetSortAriaLabel("Borough", nameof(DobjobFiling.Borough))"
                                aria-sort="@GetAriaSort(nameof(DobjobFiling.Borough))">
                            <span>Borough</span>
                            <span class="sort-indicator" aria-hidden="true">@GetSortIndicator(nameof(DobjobFiling.Borough))</span>
                        </button>
                    </HeaderTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DobjobFiling" Property="JobType" Title="Trade" Width="100px">
                    <HeaderTemplate>
                        <button type="button" class="grid-sort-header-btn"
                                @onclick="() => SortByColumn(nameof(DobjobFiling.JobType))"
                                aria-label="@GetSortAriaLabel("Trade", nameof(DobjobFiling.JobType))"
                                aria-sort="@GetAriaSort(nameof(DobjobFiling.JobType))">
                            <span>Trade</span>
                            <span class="sort-indicator" aria-hidden="true">@GetSortIndicator(nameof(DobjobFiling.JobType))</span>
                        </button>
                    </HeaderTemplate>
                    <Template Context="filing">
                        <span class="trade-tag trade-plumb">@filing.JobType</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DobjobFiling" Property="InitialCost" Title="Est. Value" Width="110px">
                    <HeaderTemplate>
                        <button type="button" class="grid-sort-header-btn"
                                @onclick="() => SortByColumn(nameof(DobjobFiling.InitialCost))"
                                aria-label="@GetSortAriaLabel("Estimated Value", nameof(DobjobFiling.InitialCost))"
                                aria-sort="@GetAriaSort(nameof(DobjobFiling.InitialCost))">
                            <span>Est. Value</span>
                            <span class="sort-indicator" aria-hidden="true">@GetSortIndicator(nameof(DobjobFiling.InitialCost))</span>
                        </button>
                    </HeaderTemplate>
                    <Template Context="filing">
                        <span class="value-cell">@filing.InitialCost?.ToString("C0")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DobjobFiling" Property="PreFilingDate" Title="Filed" Width="120px">
                    <HeaderTemplate>
                        <button type="button" class="grid-sort-header-btn"
                                @onclick="() => SortByColumn(nameof(DobjobFiling.PreFilingDate))"
                                aria-label="@GetSortAriaLabel("Filing Date", nameof(DobjobFiling.PreFilingDate))"
                                aria-sort="@GetAriaSort(nameof(DobjobFiling.PreFilingDate))">
                            <span>Filed</span>
                            <span class="sort-indicator" aria-hidden="true">@GetSortIndicator(nameof(DobjobFiling.PreFilingDate))</span>
                        </button>
                    </HeaderTemplate>
                    <Template Context="filing">
                        <span class="date-cell">@filing.PreFilingDate?.ToString("MM/dd/yyyy")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DobjobFiling" Property="LatestActionDate" Title="Last Activity" Width="120px">
                    <HeaderTemplate>
                        <button type="button" class="grid-sort-header-btn"
                                @onclick="() => SortByColumn(nameof(DobjobFiling.LatestActionDate))"
                                aria-label="@GetSortAriaLabel("Last Activity Date", nameof(DobjobFiling.LatestActionDate))"
                                aria-sort="@GetAriaSort(nameof(DobjobFiling.LatestActionDate))">
                            <span>Last Activity</span>
                            <span class="sort-indicator" aria-hidden="true">@GetSortIndicator(nameof(DobjobFiling.LatestActionDate))</span>
                        </button>
                    </HeaderTemplate>
                    <Template Context="filing">
                        <span class="date-cell">@filing.LatestActionDate?.ToString("MM/dd/yyyy")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DobjobFiling" Property="LeadScore" Title="Predictive Score" Width="160px">
                    <HeaderTemplate>
                        <button type="button" class="grid-sort-header-btn"
                                @onclick="() => SortByColumn(nameof(DobjobFiling.LeadScore))"
                                aria-label="@GetSortAriaLabel("Predictive Score", nameof(DobjobFiling.LeadScore))"
                                aria-sort="@GetAriaSort(nameof(DobjobFiling.LeadScore))">
                            <span>Predictive Score</span>
                            <span class="sort-indicator" aria-hidden="true">@GetSortIndicator(nameof(DobjobFiling.LeadScore))</span>
                        </button>
                    </HeaderTemplate>
                    <Template Context="filing">
                        @if (filing.LeadScore.HasValue)
                        {
                            var factorSummary = filing.LeadScoreBreakdown?.Factors?.Any() == true
                                ? string.Join(" • ", filing.LeadScoreBreakdown.Factors.Select(f => f.Name))
                                : $"Predictive lead score: {filing.LeadScore}/5";
                            <div class="flex items-center imp-gap-1" title="@factorSummary" style="cursor: help;">
                                <span style="font-weight: 700; color: #FFB400; font-size: 0.95rem;">@filing.LeadScore★</span>
                                <span class="badge @(filing.LeadScore >= 4 ? "badge-danger" : (filing.LeadScore == 3 ? "badge-warning" : "badge-info"))"
                                      style="font-size: 0.75rem; padding: 0.15rem 0.45rem; font-weight: 600;">
                                    @(filing.LeadScoreBreakdown?.Tier?.ToUpper() ?? (filing.LeadScore >= 4 ? "HOT" : "STANDARD"))
                                </span>
                            </div>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DobjobFiling" Property="JobStatusDescrp" Title="Status" Width="140px">
                    <HeaderTemplate>
                        <button type="button" class="grid-sort-header-btn"
                                @onclick="() => SortByColumn(nameof(DobjobFiling.JobStatusDescrp))"
                                aria-label="@GetSortAriaLabel("Status", nameof(DobjobFiling.JobStatusDescrp))"
                                aria-sort="@GetAriaSort(nameof(DobjobFiling.JobStatusDescrp))">
                            <span>Status</span>
                            <span class="sort-indicator" aria-hidden="true">@GetSortIndicator(nameof(DobjobFiling.JobStatusDescrp))</span>
                        </button>
                    </HeaderTemplate>
                    <Template Context="filing">
                        @{
                            var (label, cssClass) = GetStatusTier(filing.JobStatusDescrp);
                        }
                        <span class="status-badge @cssClass">@label</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DobjobFiling" Title="" Width="100px" Sortable="false" Filterable="false">
                    <Template Context="filing">
                        <button type="button" class="action-btn" @onclick="() => SaveAsLead(filing)"
                                aria-label="@($"Save as lead: {filing.HouseNum} {filing.StreetName}")"
                                aria-pressed="@(savedFilingIds.Contains(filing.Id) ? "true" : "false")"
                                title="Save as lead">
                            <RadzenIcon Icon="star" Style="font-size: 16px;" aria-hidden="true" />
                        </button>
                        <button type="button" class="action-btn" @onclick="() => ViewDetail(filing)"
                                aria-label="@($"View details for {filing.HouseNum} {filing.StreetName}")"
                                title="View details">
                            <span aria-hidden="true">→</span>
                        </button>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>

    @* ── Mobile: Card List (hidden above 768px) ── *@
    <div class="mobile-cards" role="region" aria-label="Permit feed cards">
        @if (permits != null)
        {
            var mobilePermits = permits.Take(mobilePageSize).ToList();
            @foreach (var filing in mobilePermits)
            {
                var (statusLabel, statusCss) = GetStatusTier(filing.JobStatusDescrp);
                <div class="mobile-card" tabindex="0" role="button"
                     aria-label="@($"Permit {filing.JobFilingNumber ?? filing.JobNum?.ToString()} at {filing.HouseNum} {filing.StreetName}")"
                     @onclick="() => ViewDetail(filing)"
                     @onkeydown="e => HandleCardKeyDown(e, filing)">
                    <div class="mobile-card-row-top">
                        <div class="mobile-card-address">@filing.HouseNum @filing.StreetName</div>
                        <div class="mobile-card-actions">
                            <button type="button" class="action-btn" @onclick="() => SaveAsLead(filing)" @onclick:stopPropagation="true"
                                    aria-label="@($"Save as lead: {filing.HouseNum} {filing.StreetName}")"
                                    aria-pressed="@(savedFilingIds.Contains(filing.Id) ? "true" : "false")"
                                    title="Save as lead">
                                <RadzenIcon Icon="star" Style="font-size: 16px;" aria-hidden="true" />
                            </button>
                            <button type="button" class="action-btn" @onclick="() => ViewDetail(filing)" @onclick:stopPropagation="true"
                                    aria-label="@($"View details for {filing.HouseNum} {filing.StreetName}")"
                                    title="View details">
                                <span aria-hidden="true">→</span>
                            </button>
                        </div>
                    </div>
                    <div class="mobile-card-meta">
                        <span>@filing.Borough</span>
                        <span class="mobile-card-sep">·</span>
                        <span class="trade-tag trade-plumb">@filing.JobType</span>
                    </div>
                    <div class="mobile-card-values">
                        <span class="value-cell">@filing.InitialCost?.ToString("C0")</span>
                        <span class="status-badge @statusCss">@statusLabel</span>
                    </div>
                    <div class="mobile-card-footer">
                        <span class="date-cell">Filed @filing.PreFilingDate?.ToString("MM/dd/yyyy")</span>
                        @if (filing.LeadScore.HasValue)
                        {
                            <span class="mobile-card-score">
                                <span style="color: #FFB400; font-weight: 700;">@filing.LeadScore★</span>
                                <span class="badge @(filing.LeadScore >= 4 ? "badge-danger" : (filing.LeadScore == 3 ? "badge-warning" : "badge-info"))"
                                      style="font-size: 0.7rem; padding: 0.1rem 0.35rem; font-weight: 600;">
                                    @(filing.LeadScoreBreakdown?.Tier?.ToUpper() ?? (filing.LeadScore >= 4 ? "HOT" : "STANDARD"))
                                </span>
                            </span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(filing.JobDescription))
                    {
                        <button type="button" class="mobile-card-desc" @onclick="() => ToggleDesc(filing.Id)" @onclick:stopPropagation="true"
                                aria-expanded="@(expandedDescIds.Contains(filing.Id).ToString().ToLower())"
                                aria-label="@($"Toggle job description for {filing.HouseNum} {filing.StreetName}")">
                            @if (expandedDescIds.Contains(filing.Id))
                            {
                                <span>@filing.JobDescription</span>
                            }
                            else
                            {
                                <span>@KonXProWebApp.Services.DescriptionHelper.Summarize(filing)</span>
                                @if (filing.JobDescription.Length > 80)
                                {
                                    <span class="desc-expand-hint" aria-hidden="true">tap to expand</span>
                                }
                            }
                        </button>
                    }
                </div>
            }
            @if (totalCount > mobilePageSize)
            {
                <div class="mobile-cards-pager">
                    <span class="mobile-cards-showing">Showing @mobilePermits.Count of @totalCount permits</span>
                    <button type="button" class="btn-load-more" @onclick="LoadMoreMobile" aria-label="Load more permits">Load More</button>
                </div>
            }
        }
        else
        {
            <div class="mobile-cards-empty" role="status">Loading permits…</div>
        }
    </div>
</div>
