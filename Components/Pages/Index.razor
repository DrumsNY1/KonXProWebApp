@page "/"
@layout KonXProWebApp.Components.Layout.LandingLayout

<!-- HERO -->
<div class="hero">
  <div class="hero-badge"><span></span> Live NYC permit data — updated daily</div>
  <h1>Find Your Next Job<br><em>Before Your Competition Does</em></h1>
  <p>KonXPro surfaces NYC building permit filings the moment they're filed — so you can reach property owners first and win more work.</p>
  <div class="hero-ctas">
    <button type="button" class="btn-hero-primary" @onclick='() => NavigationManager.NavigateTo("Login?register=true")'>
      <RadzenIcon Icon="bolt" Style="font-size: 18px; vertical-align: middle; margin-right: 4px;" /> Start Free Trial
    </button>
    <button type="button" class="btn-hero-secondary" @onclick='() => NavigationManager.NavigateTo("#how")'>
      <RadzenIcon Icon="play_arrow" Style="font-size: 18px; vertical-align: middle; margin-right: 4px;" /> Watch Demo
    </button>
  </div>

  <div class="browser-mockup">
    <div class="browser-bar">
      <div class="browser-dots"><span></span><span></span><span></span></div>
      <div class="browser-url">app.konxpro.com/permit-feed</div>
    </div>
    <table class="mock-table">
      <thead>
        <tr>
          <th>Permit #</th>
          <th>Address</th>
          <th>Borough</th>
          <th>Trade</th>
          <th>Est. Value</th>
          <th>Filed</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="permit-num mobile-hide" data-label="Permit #">B-2024-0472</td>
          <td data-label="Address">245 E 72nd St</td>
          <td data-label="Borough">Manhattan</td>
          <td class="mobile-hide" data-label="Trade">Plumbing</td>
          <td class="value-cell" data-label="Est. Value">$87,000</td>
          <td class="text-muted-color mobile-hide" data-label="Filed">Today</td>
          <td data-label="Status"><span class="badge badge-hot">HOT</span></td>
        </tr>
        <tr>
          <td class="permit-num mobile-hide" data-label="Permit #">B-2024-0471</td>
          <td data-label="Address">1142 Flatbush Ave</td>
          <td data-label="Borough">Brooklyn</td>
          <td class="mobile-hide" data-label="Trade">General</td>
          <td class="value-cell" data-label="Est. Value">$210,000</td>
          <td class="text-muted-color mobile-hide" data-label="Filed">Today</td>
          <td data-label="Status"><span class="badge badge-new">NEW</span></td>
        </tr>
        <tr>
          <td class="permit-num mobile-hide" data-label="Permit #">B-2024-0470</td>
          <td data-label="Address">38-12 Junction Blvd</td>
          <td data-label="Borough">Queens</td>
          <td class="mobile-hide" data-label="Trade">Electrical</td>
          <td class="value-cell" data-label="Est. Value">$45,500</td>
          <td class="text-muted-color mobile-hide" data-label="Filed">Yesterday</td>
          <td data-label="Status"><span class="badge badge-open">OPEN</span></td>
        </tr>
        <tr>
          <td class="permit-num mobile-hide" data-label="Permit #">B-2024-0469</td>
          <td data-label="Address">820 Morris Ave</td>
          <td data-label="Borough">Bronx</td>
          <td class="mobile-hide" data-label="Trade">Roofing</td>
          <td class="value-cell" data-label="Est. Value">$132,000</td>
          <td class="text-muted-color mobile-hide" data-label="Filed">Yesterday</td>
          <td data-label="Status"><span class="badge badge-new">NEW</span></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- STATS BAR -->
<div class="stats-bar">
  <div class="stat-item">
    <div class="stat-number">50,000<span>+</span></div>
    <div class="stat-label">Permits tracked annually</div>
  </div>
  <div class="stat-item">
    <div class="stat-number">5</div>
    <div class="stat-label">NYC Boroughs covered daily</div>
  </div>
  <div class="stat-item">
    <div class="stat-number">&lt; 24<span>h</span></div>
    <div class="stat-label">Alert turnaround speed</div>
  </div>
  <div class="stat-item">
    <div class="stat-number">100<span>%</span></div>
    <div class="stat-label">Public DOB records monitored</div>
  </div>
</div>

<!-- HOW IT WORKS -->
<section id="how">
  <div class="text-center">
    <div class="section-tag">How It Works</div>
    <h2>From permit filed to you on-site —<br>in three steps</h2>
    <p class="section-sub imp-mx-auto">No scraping, no cold lists. Just real-time permit intelligence delivered straight to your dashboard.</p>
  </div>
  <div class="how-grid">
    <div class="how-card">
      <div class="how-step">1</div>
      <h3>Set Your Trade & Territory</h3>
      <p>Choose your trade (plumbing, electrical, GC, roofing, and more) and the boroughs or neighborhoods you work in. KonXPro filters everything else out.</p>
      <div class="connector"></div>
    </div>
    <div class="how-card">
      <div class="how-step">2</div>
      <h3>Get Real-Time Alerts</h3>
      <p>The moment NYC DOB files a permit that matches your criteria, you get an instant alert — email, SMS, or in-app push. You're always first to know.</p>
      <div class="connector"></div>
    </div>
    <div class="how-card">
      <div class="how-step">3</div>
      <h3>Contact the Owner & Win the Job</h3>
      <p>Each permit includes the property owner's contact details, filing history, and estimated job value. Reach out before your competitors even hear about it.</p>
    </div>
  </div>
</section>

<!-- FEATURES -->
<section id="features">
  <div>
    <div class="section-tag">Features</div>
    <h2>Everything you need to dominate<br>your local market</h2>
    <p class="section-sub">Built specifically for NYC trade contractors, not generic lead gen tools.</p>
  </div>
  <div class="features-grid">
    <div class="feature-card" id="feature-feed">
      <div class="feature-icon"><RadzenIcon Icon="bolt" Style="font-size: 28px; color: var(--color-primary-light);" /></div>
      <h3>Real-Time Permit Feed</h3>
      <p>Ingests NYC DOB filings within minutes of submission. Filter by trade, borough, estimated value, and filing type.</p>
    </div>
    <div class="feature-card" id="feature-map">
      <div class="feature-icon"><RadzenIcon Icon="map" Style="font-size: 28px; color: var(--color-primary-light);" /></div>
      <h3>Interactive Trade Map</h3>
      <p>Visualize permit density across all five boroughs. Spot hot zones before your competitors and plan your outreach geographically.</p>
    </div>
    <div class="feature-card" id="feature-alerts">
      <div class="feature-icon"><RadzenIcon Icon="notifications" Style="font-size: 28px; color: var(--color-primary-light);" /></div>
      <h3>Instant Alerts</h3>
      <p>Get notified the moment a matching permit drops — via email, SMS, or push. Customize alert thresholds by job value and urgency.</p>
    </div>
    <div class="feature-card" id="feature-crm">
      <div class="feature-icon"><RadzenIcon Icon="analytics" Style="font-size: 28px; color: var(--color-primary-light);" /></div>
      <h3>Lead Pipeline CRM</h3>
      <p>Save, tag, and track permit leads through your sales process. Add notes, set follow-up reminders, and never drop a hot lead again.</p>
    </div>
    <div class="feature-card" id="feature-owner-data">
      <div class="feature-icon"><RadzenIcon Icon="assignment" Style="font-size: 28px; color: var(--color-primary-light);" /></div>
      <h3>Owner Contact Data</h3>
      <p>Access verified property owner details — phone, email, and mailing address — directly from the permit filing record.</p>
    </div>
    <div class="feature-card" id="feature-reports">
      <div class="feature-icon"><RadzenIcon Icon="trending_up" Style="font-size: 28px; color: var(--color-primary-light);" /></div>
      <h3>Market Reports</h3>
      <p>Weekly and monthly reports showing permit volume trends, average job values, and competitive density by trade and borough.</p>
    </div>
  </div>
</section>

<!-- TRADE WORKFLOWS -->
<div class="testimonials-section">
  <div class="testimonials-inner">
    <div class="section-tag">Trade Workflows</div>
    <h2>Built for Every Trade Across NYC</h2>
    <p class="section-sub">How licensed trade specialists use real-time permit filings to beat the competition to the job.</p>
    <div class="testimonials-grid">
      <div class="testimonial-card">
        <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--color-primary-light); margin-bottom: 12px;">Plumbing & Mechanical</div>
        <p class="testimonial-text">"Catch newly filed boiler installations, backflow prevention, and sprinkler alterations before general contractors begin subcontracting. Reach owners while job plans and contractor selections are active."</p>
        <div class="testimonial-author">
          <div class="author-avatar">PL</div>
          <div>
            <div class="author-name">Plumbing & HVAC Contractors</div>
            <div class="author-title">Manhattan · Brooklyn · Queens</div>
          </div>
        </div>
      </div>
      <div class="testimonial-card">
        <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--color-primary-light); margin-bottom: 12px;">General Contractors</div>
        <p class="testimonial-text">"Track Alt-1 and Alt-2 building renovations across all five boroughs. Filter for job values above $100K and connect with property owners and expediters the very morning permit drawings are submitted."</p>
        <div class="testimonial-author">
          <div class="author-avatar">GC</div>
          <div>
            <div class="author-name">General Contractors & Builders</div>
            <div class="author-title">Five Borough Territory Coverage</div>
          </div>
        </div>
      </div>
      <div class="testimonial-card">
        <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--color-primary-light); margin-bottom: 12px;">Electrical & Roofing</div>
        <p class="testimonial-text">"Electrical service upgrades, solar installations, and emergency roofing permits demand immediate outreach. Real-time alerts ensure your firm is the first licensed team contacting the property owner."</p>
        <div class="testimonial-author">
          <div class="author-avatar">EL</div>
          <div>
            <div class="author-name">Electrical & Roofing Specialists</div>
            <div class="author-title">Bronx · Staten Island · Queens</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- PRICING -->
<section id="pricing">
  <div class="text-center">
    <div class="section-tag">Pricing</div>
    <h2>Simple, transparent pricing</h2>
    <p class="section-sub imp-mx-auto">No setup fees. No contracts. Cancel anytime.</p>
  </div>
  <div class="pricing-grid">
    <div class="pricing-card">
      <div class="plan-name">Starter</div>
      <div class="plan-price"><sup>$</sup>49<sub>/mo</sub></div>
      <div class="plan-desc">For solo contractors getting started with permit leads.</div>
      <ul class="plan-features">
        <li>1 trade, 1 borough</li>
        <li>Up to 50 leads/month</li>
        <li>Daily email digest</li>
        <li>Basic permit data</li>
        <li>7-day lead history</li>
      </ul>
      <button type="button" class="btn-plan btn-plan-ghost" @onclick='() => NavigationManager.NavigateTo("Login?register=true&tier=Starter")'>Get Started</button>
    </div>
    <div class="pricing-card featured">
      <div class="pricing-badge">Most Popular</div>
      <div class="plan-name">Pro</div>
      <div class="plan-price"><sup>$</sup>149<sub>/mo</sub></div>
      <div class="plan-desc">For active contractors who want every edge in the market.</div>
      <ul class="plan-features">
        <li>3 trades, all 5 boroughs</li>
        <li>Unlimited leads</li>
        <li>Real-time SMS + push alerts</li>
        <li>Owner contact data</li>
        <li>Pipeline CRM</li>
        <li>Trade map access</li>
        <li>30-day lead history</li>
      </ul>
      <button type="button" class="btn-plan btn-plan-primary" @onclick='() => NavigationManager.NavigateTo("Login?register=true&tier=Pro")'>Start Free Trial</button>
    </div>
    <div class="pricing-card">
      <div class="plan-name">Agency</div>
      <div class="plan-price"><sup>$</sup>349<sub>/mo</sub></div>
      <div class="plan-desc">For multi-trade operations, crews, and lead-gen agencies.</div>
      <ul class="plan-features">
        <li>Unlimited trades & boroughs</li>
        <li>Up to 5 team seats</li>
        <li>Custom alert workflows</li>
        <li>White-label exports</li>
        <li>API access</li>
        <li>Dedicated account manager</li>
        <li>Full permit history</li>
      </ul>
      <button type="button" class="btn-plan btn-plan-ghost" @onclick='() => NavigationManager.NavigateTo("contact-us?plan=Agency")'>Contact Sales</button>
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<div class="final-cta">
  <h2>Stop chasing jobs.<br>Start getting called first.</h2>
  <p>Get instant access to live NYC building permits before your competition does.</p>
  <div class="flex justify-center flex-wrap imp-gap-4">
    <button type="button" class="btn-hero-primary" @onclick='() => NavigationManager.NavigateTo("Login?register=true")'><RadzenIcon Icon="bolt" Style="font-size: 18px; vertical-align: middle; margin-right: 4px;" /> Start Free Trial — No Credit Card</button>
    <button type="button" class="btn-hero-secondary" @onclick='() => NavigationManager.NavigateTo("contact-us")'>Talk to Sales</button>
  </div>
</div>

