<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <NoWarn>CS0168,CS1998,BL9993,CS0649,CS0436,0436</NoWarn>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Components\Pages\ClaudeDobFilings.razor.cs" />
    <Compile Remove="Components\Pages\EditDobjobFiling.razor.cs" />
    <Compile Remove="KonXProWebApp.Functions\**" />
    <Content Remove="KonXProWebApp.Functions\**" />
    <EmbeddedResource Remove="KonXProWebApp.Functions\**" />
    <None Remove="KonXProWebApp.Functions\**" />
    <Compile Remove="KonXProWebApp.Tests\**" />
    <Content Remove="KonXProWebApp.Tests\**" />
    <EmbeddedResource Remove="KonXProWebApp.Tests\**" />
    <None Remove="KonXProWebApp.Tests\**" />
    <Compile Remove="KonXProWebApp.Functions.Tests\**" />
    <Content Remove="KonXProWebApp.Functions.Tests\**" />
    <EmbeddedResource Remove="KonXProWebApp.Functions.Tests\**" />
    <None Remove="KonXProWebApp.Functions.Tests\**" />
    <Compile Remove="KonXProWebApp.Integration.Tests\**" />
    <Content Remove="KonXProWebApp.Integration.Tests\**" />
    <EmbeddedResource Remove="KonXProWebApp.Integration.Tests\**" />
    <None Remove="KonXProWebApp.Integration.Tests\**" />
    <Compile Remove="KonXProWebApp.E2E.Tests\**" />
    <Content Remove="KonXProWebApp.E2E.Tests\**" />
    <EmbeddedResource Remove="KonXProWebApp.E2E.Tests\**" />
    <None Remove="KonXProWebApp.E2E.Tests\**" />
    <!--
      Local tooling and working folders. These are developer scratch space, not
      part of the application: keep them out of the build and out of publish
      output. They are also listed in .gitignore.
    -->
    <Compile Remove="_tools\**" />
    <Content Remove="_tools\**" />
    <EmbeddedResource Remove="_tools\**" />
    <None Remove="_tools\**" />
    <Compile Remove="scratch\**" />
    <Content Remove="scratch\**" />
    <EmbeddedResource Remove="scratch\**" />
    <None Remove="scratch\**" />
    <Compile Remove="logs\**" />
    <Content Remove="logs\**" />
    <EmbeddedResource Remove="logs\**" />
    <None Remove="logs\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Components\Pages\ClaudeDobFilings.razor" />
    <Content Remove="Components\Pages\EditDobjobFiling.razor" />
    <Content Remove="Components\Pages\HighTierDashboard.razor" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KonXProWebApp.Integration.Tests" />
  </ItemGroup>
  <!-- Versions are centralized in Directory.Packages.props -->
  <ItemGroup>
    <PackageReference Include="Radzen.Blazor" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.HeaderPropagation" />
    <PackageReference Include="Microsoft.AspNetCore.OData" />
    <PackageReference Include="Stripe.net" />
  </ItemGroup>
</Project>
