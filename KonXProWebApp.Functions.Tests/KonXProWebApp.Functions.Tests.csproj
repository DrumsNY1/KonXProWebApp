<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Versions are centralized in Directory.Packages.props -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />

    <!--
      Microsoft.Data.SqlClient takes the central 6.1.6, matching what
      KonXProWebApp.Functions resolves. This project previously asked for 6.0.1,
      which is a downgrade of the library the code under test depends on
      (NU1605). It only ever restored because the two projects were last
      restored at different times against a floating 6.* range, so no single
      restore saw both constraints. Keep these two aligned.
    -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KonXProWebApp.Functions\KonXProWebApp.Functions.csproj" />
    <ProjectReference Include="..\KonXProWebApp.csproj" />
  </ItemGroup>

</Project>
